+        common: HlpRebalancePlanCommon,
+        ylp_burn_amount: u64,
+        base_entitlement_amount: u64,
+        quote_entitlement_amount: u64,
+        base_reserve_debit: u64,
+        quote_reserve_debit: u64,
+        base_cash_debit: u64,
+        quote_cash_debit: u64,
+        debt_repayment: DebtRepaymentQuote,

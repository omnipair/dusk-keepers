{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipair.dev/schemas/dusk/deployment-profiles.schema.json",
  "title": "Dusk keeper deployment profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "services"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "profile", "jobKinds", "liveRuntime", "shadowRuntime", "walletRole", "signingRequired"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "jobKinds": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "candidate-intent.schema.json#/$defs/jobKind" }
          },
          "liveRuntime": { "enum": ["rust", "typescript"] },
          "shadowRuntime": { "enum": ["rust", "typescript"] },
          "walletRole": { "type": "string", "minLength": 1 },
          "signingRequired": { "type": "boolean" }
        }
      }
    }
  }
}

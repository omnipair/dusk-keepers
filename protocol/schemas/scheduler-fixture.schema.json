{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipair.dev/schemas/dusk/scheduler-fixture.schema.json",
  "title": "Cross-runtime scheduler fixture bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "lockedConflictKeys", "candidates", "expectedOrder"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "lockedConflictKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "candidates": { "type": "array", "items": { "$ref": "candidate-intent.schema.json" } },
          "expectedOrder": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}


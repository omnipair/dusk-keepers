{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipair.dev/schemas/dusk/account-resolution-manifest.schema.json",
  "title": "IDL-derived deterministic account resolution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "protocolRevision",
    "programs",
    "staticAccounts",
    "pdaRecipes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "protocolRevision": { "type": "string", "minLength": 1 },
    "programs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "programId", "idlSha256"],
        "properties": {
          "name": { "enum": ["dusk", "leverage_delegate"] },
          "programId": { "$ref": "#/$defs/pubkey" },
          "idlSha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "staticAccounts": {
      "type": "array",
      "items": { "$ref": "#/$defs/staticAccount" }
    },
    "pdaRecipes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pdaRecipe" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pubkey": {
      "type": "string",
      "minLength": 32,
      "maxLength": 44,
      "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
    },
    "staticAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructionKey", "accountName", "address", "source"],
      "properties": {
        "instructionKey": { "type": "string", "minLength": 1 },
        "accountName": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/pubkey" },
        "source": {
          "enum": ["idl_fixed_address", "instruction_program", "action_cpi_program"]
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructionKey", "accountName", "idlSeedPaths"],
      "properties": {
        "instructionKey": { "type": "string", "minLength": 1 },
        "accountName": { "type": "string", "minLength": 1 },
        "idlSeedPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "valueHex"],
      "properties": {
        "kind": { "const": "const" },
        "valueHex": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{2})+$"
        }
      }
    },
    "inputSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "encoding"],
      "properties": {
        "kind": { "const": "input" },
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "encoding": { "enum": ["pubkey", "bytes32", "u64_le"] }
      }
    },
    "pdaRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "program", "programId", "usages", "seeds"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "program": { "enum": ["dusk", "leverage_delegate"] },
        "programId": { "$ref": "#/$defs/pubkey" },
        "usages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/usage" }
        },
        "seeds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/constSeed" },
              { "$ref": "#/$defs/inputSeed" }
            ]
          }
        }
      }
    }
  }
}

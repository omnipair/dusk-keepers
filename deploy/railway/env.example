KEEPER_MODE=shadow
KEEPER_PROFILE=leverage
PORT=8080
DUSK_PROTOCOL_LOCK=/app/protocol.lock.json
SOLANA_RPC_HTTP_URL=https://replace-me.invalid
SOLANA_RPC_WS_URL=wss://replace-me.invalid
INDEXER_URL=https://replace-me.invalid
DATABASE_URL=postgresql://replace-me.invalid
REDIS_URL=redis://replace-me.invalid
SIGNER_PROVIDER=remote
SIGNER_KEY_ID=replace-me
MARKET_ALLOWLIST=replace-me
MAX_CONCURRENCY=4
LEASE_TTL_SECONDS=60
MAX_OBSERVATION_AGE_SLOTS=32

# Candidate liquidation runtime: public identity only in shadow.
KEEPER_SHADOW_PUBLIC_KEY=replace-with-public-key
KEEPER_FLASH_SETTLEMENT=dusk
# Required raw-atom bounds: configure explicitly for the worker's market(s).
# KEEPER_FLASH_MAX_REPAY=
# KEEPER_LIQUIDATION_MIN_PROFIT=
# KEEPER_LIQUIDATION_LOOKUP_TABLE=
# Inventory mode additionally requires these explicit purchase bounds:
# KEEPER_FLASH_MARKET=
# KEEPER_FLASH_MAX_PAYMENT_DEBIT=
# KEEPER_FLASH_MIN_COLLATERAL_CREDIT=

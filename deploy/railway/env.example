KEEPER_MODE=shadow
KEEPER_PROFILE=lending
KEEPER_LENDING_MODE=both
PORT=8080
DUSK_PROTOCOL_LOCK=/app/protocol.lock.json
SOLANA_RPC_HTTP_URL=https://replace-me.invalid
SOLANA_RPC_WS_URL=wss://replace-me.invalid
INDEXER_URL=https://replace-me.invalid
DATABASE_URL=postgresql://replace-me.invalid
REDIS_URL=redis://replace-me.invalid
SIGNER_PROVIDER=remote
SIGNER_KEY_ID=replace-me
MARKET_ALLOWLIST=replace-me
MAX_CONCURRENCY=4
LEASE_TTL_SECONDS=60
MAX_OBSERVATION_AGE_SLOTS=32

# Candidate liquidation runtime: public identity only in shadow.
# Execution workers perform health previews themselves. Shadow mode needs no key.
KEEPER_SHADOW_PUBLIC_KEY=replace-with-public-key
KEEPER_FLASH_SETTLEMENT=jupiter
# Jupiter serves mainnet. Explicitly use dusk for the captured devnet deployment.
# See docs/runbooks/jupiter-routing.md for supported routes and release checks.
# Ordinary mode and the ordinary leg of both require KEEPER_FLASH_MAX_REPAY.
# Emergency, Jupiter and internal ordinary settlement require KEEPER_LIQUIDATION_MIN_PROFIT.
# Required raw-atom bounds: configure explicitly for the worker's market(s).
# KEEPER_FLASH_MAX_REPAY=
# KEEPER_LIQUIDATION_MIN_PROFIT=
# Optional emergency quote tolerance, 0..10000 basis points (default 0).
# The minimum profit remains enforced on chain. 10 = 0.1%; 10000 = 100%.
# KEEPER_EMERGENCY_SLIPPAGE_BPS=0
# KEEPER_LIQUIDATION_LOOKUP_TABLE=
# Jupiter settings (defaults shown; API key belongs in the service secret store):
# KEEPER_JUPITER_SLIPPAGE_BPS=50
# KEEPER_JUPITER_MAX_ACCOUNTS=32
# KEEPER_JUPITER_MAX_BUILDS=4
# KEEPER_JUPITER_MAX_BUILDS_PER_PASS=12
# KEEPER_JUPITER_TIMEOUT_MS=5000
# KEEPER_JUPITER_REQUEST_INTERVAL_MS=2100
# KEEPER_JUPITER_MAX_AGE_MS=10000
# KEEPER_JUPITER_PRIORITY_FEE_LAMPORTS=0
# KEEPER_JUPITER_MAX_SOL_DEBIT_LAMPORTS=20000000
# Inventory mode additionally requires these explicit purchase bounds:
# KEEPER_FLASH_MARKET=
# KEEPER_FLASH_MAX_PAYMENT_DEBIT=
# KEEPER_FLASH_MIN_COLLATERAL_CREDIT=

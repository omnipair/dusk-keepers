{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipair.dev/schemas/dusk/instruction-contract.schema.json",
  "title": "IDL-derived keeper instruction contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "protocolRevision", "programs", "actions", "instructions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "protocolRevision": { "type": "string", "minLength": 1 },
    "programs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "programId", "idlPath", "idlSha256"],
        "properties": {
          "name": { "enum": ["dusk", "leverage_delegate"] },
          "programId": { "type": "string", "minLength": 32, "maxLength": 44 },
          "idlPath": { "type": "string", "minLength": 1 },
          "idlSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "jobKind", "primaryInstructionKey", "cpiInstructionKeys", "requiredOptionalAccounts"],
        "properties": {
          "action": { "$ref": "job-intent.schema.json#/$defs/jobAction" },
          "jobKind": { "$ref": "candidate-intent.schema.json#/$defs/jobKind" },
          "primaryInstructionKey": { "type": "string", "minLength": 1 },
          "cpiInstructionKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "requiredOptionalAccounts": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "program", "programId", "instructionName", "discriminatorHex", "accounts"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "program": { "enum": ["dusk", "leverage_delegate"] },
          "programId": { "type": "string", "minLength": 32, "maxLength": 44 },
          "instructionName": { "type": "string", "minLength": 1 },
          "discriminatorHex": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "writable", "signer", "optional", "fixedAddress"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "writable": { "type": "boolean" },
                "signer": { "type": "boolean" },
                "optional": { "type": "boolean" },
                "fixedAddress": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "minLength": 32, "maxLength": 44 }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}


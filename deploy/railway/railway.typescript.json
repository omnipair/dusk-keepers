{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/typescript.Dockerfile",
    "watchPatterns": [
      "package.json",
      "protocol.lock.json",
      "typescript/**",
      "deploy/railway/typescript.Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ALWAYS"
  }
}


# Mainnet candidate configuration. Keep shadow until the frozen release gate passes.
KEEPER_MODE=shadow
KEEPER_PROFILE=lending
KEEPER_LENDING_MODE=both
PORT=8080
DISCOVERY_INTERVAL_MS=5000
KEEPER_MAX_SCAN_AGE_MS=120000
KEEPER_MAX_SENDS_PER_PASS=1
KEEPER_MINIMUM_LAMPORTS=50000000
KEEPER_LOG_COLOR=auto
KEEPER_LOG_POSITIONS=1

# Inject RPC/database credentials via the service secret store, not this file.
SOLANA_RPC_HTTP_URL=https://replace-me.invalid
DATABASE_URL=postgresql://replace-me.invalid
# Public PEM CA certificate, when the database uses a private CA:
# DATABASE_CA_CERT=/run/config/database-ca.pem

# Distinct public identities and KMS key per signing service.
SIGNER_PROVIDER=aws-kms
AWS_REGION=us-east-1
SIGNER_KEY_ID=
KEEPER_SIGNER_PUBLIC_KEY=
KEEPER_SHADOW_PUBLIC_KEY=
# Mount a reviewed copy of risk-policy.example.json here. This path is required
# in live mainnet; the example file is never selected automatically.
KEEPER_RISK_POLICY=/run/config/keeper-risk-policy.json

# Lending and leverage: all supported markets. These legacy global atom limits
# are further restricted by each mint's transaction/day cap in the risk policy.
KEEPER_FLASH_SETTLEMENT=inventory
KEEPER_FLASH_MAX_REPAY=18446744073709551615
KEEPER_FLASH_MAX_PAYMENT_DEBIT=18446744073709551615
KEEPER_FLASH_MIN_COLLATERAL_CREDIT=1
KEEPER_LIQUIDATION_MIN_PROFIT=0
KEEPER_EMERGENCY_SLIPPAGE_BPS=100
KEEPER_ORDER_MIN_BOUNTY_CREDIT=0
# KEEPER_LIQUIDATION_LOOKUP_TABLE=<verified active table>

# hLP recovery additionally requires an explicit market and all four bounds:
# KEEPER_HLP_MARKET=
# KEEPER_HLP_MAX_SOCIALIZED_LOSS=
# KEEPER_HLP_MAX_PAYMENT_DEBIT=
# KEEPER_HLP_MIN_COLLATERAL_CREDIT=
# KEEPER_HLP_MIN_BOUNTY_OUT=

# Auction purchases additionally require explicit sold/payment atom limits.
# This worker buys protocol revenue; it does not guarantee resale or net profit.
# KEEPER_AUCTION_MAX_SOLD=
# KEEPER_AUCTION_MAX_PAYMENT=
# KEEPER_AUCTION_SLIPPAGE_BPS=50

# Lifecycle needs only fee/reserve limits. Sentinel has no signer or spending policy.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnipair.dev/schemas/dusk/instruction-envelope-fixture.schema.json",
  "title": "Cross-runtime instruction envelope fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "validCases", "invalidCases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "validCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "envelope"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "envelope": { "$ref": "instruction-envelope.schema.json" }
        }
      }
    },
    "invalidCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expectedError", "envelope"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "expectedError": {
            "enum": [
              "revision_mismatch",
              "job_kind_mismatch",
              "instruction_mismatch",
              "program_id_mismatch",
              "invalid_pubkey",
              "invalid_data_hex",
              "discriminator_mismatch",
              "missing_required_account",
              "account_order_mismatch",
              "account_flags_mismatch",
              "fixed_address_mismatch",
              "required_optional_account_missing",
              "cpi_hook_mismatch",
              "remaining_accounts_mismatch",
              "delegated_hook_data_mismatch",
              "parity_mismatch",
              "live_protocol_not_ready"
            ]
          },
          "envelope": { "$ref": "instruction-envelope.schema.json" }
        }
      }
    }
  }
}
